    {
      "id": 2,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": {},
      "filter": {
        "name": "Low Stock Alert",
        "conditions": [
          [
            {
              "a": "{{6.row.f.value}}",
              "o": "number:lessorequal",
              "b": "{{6.row.g.value}}"
            },
            {
              "a": "{{6.row.j.text}}",
              "o": "text:notequal",
              "b": "{{formatDate(now; \"M/D/YYYY\"; \"Asia/Qatar\")}}"
            }
          ]
        ]
      },
      "mapper": {
        "to": [
          "your-email@example.com"
        ],
        "subject": "🚨 Low Stock Alert - Smart Inventory System",
        "bodyType": "rawHtml",
        "content": "<h2>🚨 LOW STOCK ALERT!</h2>\r\n\r\n<p><strong>Product Name:</strong> {{6.row.b.value}}</p>\r\n<p><strong>Product ID:</strong>{{6.row.a.value}}</p>\r\n<p><strong>Current Stock:</strong>{{6.row.f.value}}</p>\r\n<p><strong>Reorder Level:</strong> {{6.row.g.value}}</p>\r\n\r\n<hr>\r\n\r\n<p><strong>Action Required:</strong> Please restock this product.</p>\r\n<p>Smart Inventory Management System</p>"
      },
